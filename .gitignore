# Corpora are fetched at run time and never committed. See docs/datasets.md.
data/

# Generated notes. Derived from corpora that publish no licence, one file per
# (task, prompt version, model, session, unit), and large: a full run is about
# 5800 of them. Kept locally so re-scoring never re-generates.
generations/

.env
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.DS_Store

# Fixtures are committed; fetched corpora are not.
!tests/fixtures/

# Service-account keys and anything else credential-shaped. Never committed.
secrets/

# Judge answers. Same reasoning as generations/: derived from unlicensed corpora,
# tens of thousands of small files, and cheaper to keep than to re-ask.
scores/

# Working handoff notes. Kept on disk, not published.
HANDOFF-*.md
