# Copy to `.env`, which is gitignored. Nothing here holds a value.
#
# Two halves, and they fail at different times. Generation needs a provider
# token from the block below; scoring needs a judge, and a run configured only
# for generation gets all the way to `tnb score` before finding out. That is
# what this file used to do: it named a key nothing reads and none of the four
# a judge needs, while `tnb score`'s own error message points here by name.

# --- Generation: one block per provider in models.yaml -----------------------
# A provider whose token is not set is skipped rather than failing the run, so
# you only need the ones you use. With only this block set, `make smoke` and
# `make bench` run against e-INFRA and nothing else.

# e-INFRA CZ AI-as-a-Service (OpenAI-compatible).
# Get one at https://chat.ai.e-infra.cz -> Account -> API keys
# Requires a MetaCentrum account or Masaryk University affiliation.
EINFRA_API_TOKEN=
EINFRA_BASE_URL=https://llm.ai.e-infra.cz/v1

# --- Scoring: the judges -----------------------------------------------------
# `tnb score`, `tnb score-icare`, `tnb calibrate`, `tnb judges` and
# `tnb preference` all need one of these. Which one depends on `--judge-model`:
# a `gemini-*` judge uses Vertex, a `gpt-*` judge uses OpenAI. The default
# judge is `gemini-3.1-pro-preview`, so the Vertex block is the one to fill
# first; the second judge on the panel is `gpt-5.6-terra`.

# Google Vertex AI. The service-account JSON belongs in `secrets/`, which is
# gitignored -- never inside this file, and never anywhere git can see it.
# Point the last one at that file, e.g. `secrets/<your-file>.json`. It is left
# blank rather than filled in with a plausible path because `tests/test_secrets`
# compares every tracked file against every value in `.env`, and a suggested
# path that somebody then uses verbatim starts failing that check for real.
VERTEX_PROJECT=
VERTEX_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=

# OpenAI, for the second judge.
OPENAI_API_KEY=
