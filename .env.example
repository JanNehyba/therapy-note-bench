# One block per provider in models.yaml. A provider whose token is not set is
# skipped rather than failing the run, so you only need the ones you use.

# e-INFRA CZ AI-as-a-Service (OpenAI-compatible).
# Get one at https://chat.ai.e-infra.cz -> Account -> API keys
# Requires a MetaCentrum account or Masaryk University affiliation.
EINFRA_API_TOKEN=
EINFRA_BASE_URL=https://llm.ai.e-infra.cz/v1

# Judge model provider. Scoring only; generation never calls this.
ANTHROPIC_API_KEY=
